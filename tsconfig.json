{
    "include": ["src"],
    "exclude": ["node_modules"],
    "compilerOptions": {
        "target": "ES2020",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "ignoreDeprecations": "6.0"
    }
}
